{
  "id": "./",
  "name": "PaintDotRust",
  "short_name": "PaintDotRust",
  "description": "An image editor descended from Paint.NET 3.36, rebuilt in Rust for the web. Layers, selections, effects, adjustments and editable shapes; works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ececec",
  "theme_color": "#ececec",
  "categories": [
    "graphics",
    "photo",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/avif": [
          ".avif"
        ],
        "image/bmp": [
          ".bmp"
        ],
        "image/gif": [
          ".gif"
        ],
        "application/x-openpdn": [
          ".openpdn"
        ],
        "application/x-paintdotnet": [
          ".pdn"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "images",
          "accept": [
            "image/*",
            ".openpdn",
            ".pdn"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "New image",
      "short_name": "New",
      "url": "./?action=new",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
